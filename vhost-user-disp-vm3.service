[Unit]
Description = launch vhost-user-qti DISP for vm3

After = remote-fs.target tmp.mount systemd-modules-load.service
Conflicts = shutdown.target
Before = shutdown.target
DefaultDependencies = no

[Service]
Slice=gvm.slice
SELinuxContext=system_u:system_r:vhost_user_qti_vm3_t:s0
ExecStart = /usr/bin/vhost-user-qti -s /tmp/linux-vm3-disp-skt -d /dev/vhost-vm3-disp -q 10
Type=notify
NotifyAccess=main

[Install]
WantedBy = multi-user.target

