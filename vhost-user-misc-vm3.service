[Unit]
Description = launch vhost-user-qti MISC for vm3

After = remote-fs.target

[Service]
SELinuxContext=system_u:system_r:vhost_user_qti_vm3_t:s0
ExecStart = /usr/bin/vhost-user-qti -s /tmp/linux-vm3-misc-skt -d /dev/vhost-vm3-misc -q 2

[Install]
WantedBy = multi-user.target

