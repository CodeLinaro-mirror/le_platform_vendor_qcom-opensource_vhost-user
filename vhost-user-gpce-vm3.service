[Unit]
Description = launch vhost-user-qti GPCE for vm3

After = remote-fs.target tmp.mount systemd-modules-load.service early-services.target
Wants = early-services.target
Conflicts = shutdown.target
Before = shutdown.target
DefaultDependencies = no

[Service]
SELinuxContext=system_u:system_r:vhost_user_qti_vm3_t:s0
ExecStart = /usr/bin/vhost-user-qti -s /tmp/linux-vm3-gpce-skt -d /dev/vhost-vm3-gpce -q 2

[Install]
WantedBy = multi-user.target

