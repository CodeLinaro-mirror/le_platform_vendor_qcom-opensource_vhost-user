[Unit]
Description = launch vhost-user-qti SOCCP for vm3

After = remote-fs.target early-services.target
Wants = early-services.target

[Service]
SELinuxContext=system_u:system_r:vhost_user_qti_vm3_t:s0
ExecStart = /usr/bin/vhost-user-qti -s /tmp/linux-vm3-soccp-skt -d /dev/vhost-vm3-soccp -q 2
Type=notify
NotifyAccess=main

[Install]
WantedBy = multi-user.target

