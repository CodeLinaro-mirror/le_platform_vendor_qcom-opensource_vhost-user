[Unit]
Description = launch vhost-user-qti Audio for vm3

After = remote-fs.target

[Service]
SELinuxContext=system_u:system_r:vhost_user_qti_vm3_t:s0
ExecStart = /usr/bin/vhost-user-qti -s /tmp/linux-vm3-aud-skt -d /dev/vhost-vm3-aud -q 8
Type=notify
NotifyAccess=main

[Install]
WantedBy = multi-user.target

